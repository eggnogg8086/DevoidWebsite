RewriteEngine On

# Don't let MultiViews interfere with directory URLs
Options -MultiViews

# Add a trailing slash to extensionless URLs
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
RewriteRule ^(.+)$ $1/ [R=302,L]

# Redirect from act1-1.php to act1-1
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ $1.php [L]